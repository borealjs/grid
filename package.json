{
  "name": "borealjs-grid-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/react"
  ],
  "scripts": {
    "build": "npm run build -w packages/grid-core && npm run build -w packages/react-grid",
    "prepare": "npm run build",
    "prestart": "npm run build",
    "start": "node server.mjs",
    "serve": "node server.mjs",
    "predev": "npm run build",
    "dev": "node scripts/dev.mjs",
    "prestart:sql": "npm run build",
    "start:sql": "BACKEND=sql node server.mjs",
    "seed:sql": "node scripts/seed-duckdb.mjs",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.mjs",
    "dev:react": "npm run dev --workspace examples/react",
    "typecheck": "npm run build && tsc -p packages/grid-core && tsc -p packages/react-grid && tsc -p test/types",
    "clean": "rm -rf packages/*/dist",
    "version-packages": "node scripts/version-packages.mjs",
    "publish-packages": "node scripts/publish-packages.mjs",
    "build:demo": "npm run build && npm run build:pages --workspace examples/react",
    "preview:demo": "npm run build:demo && npm run preview:pages --workspace examples/react",
    "test:coverage": "c8 --include=\"packages/grid-core/src/**\" --reporter=text-summary --reporter=html node --import tsx --test test/*.test.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^12.0.0",
    "fast-check": "^4.10.3",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
